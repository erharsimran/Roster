generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organizations & Locations ──────────────────────────────

model Organization {
  id          String       @id @default(uuid())
  name        String
  timezone    String       @default("UTC")
  createdAt   DateTime     @default(now()) @map("created_at")
  locations   Location[]
  roles       Role[]
  positions   Position[]
  shiftTrades ShiftTrade[]
  TimeEntry   TimeEntry[]

  @@map("organizations")
}

model Location {
  id                      String   @id @default(uuid())
  orgId                   String   @map("org_id")
  name                    String
  timezone                String
  address                 String?
  latitude                Float?
  longitude               Float?
  geofenceRadiusMeters    Int      @default(150) @map("geofence_radius_meters")
  operatingHours          Json?    @map("operating_hours")
  requireLeadershipOnDuty Boolean  @default(false) @map("require_leadership_on_duty")
  createdAt               DateTime @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shifts          Shift[]
  timeEntries     TimeEntry[]
  timeOffRequests TimeOffRequest[]
  recurrenceRules RecurrenceRule[]

  @@index([orgId])
  @@map("locations")
}

// ─── Users & RBAC ────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  fullName     String   @map("full_name")
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")

  userRoles         UserRole[]
  employeePositions EmployeePosition[]
  shiftsAssigned    Shift[]            @relation("AssignedShifts")
  shiftsCreated     Shift[]            @relation("CreatedShifts")
  timeEntries       TimeEntry[]
  initiatedTrades   ShiftTrade[]       @relation("TradeSourceUser")
  receivedTrades    ShiftTrade[]       @relation("TradeTargetUser")
  timeOffRequests   TimeOffRequest[]
  rolesUpdated      Role[]             @relation("RoleLastUpdatedBy")

  @@map("users")
}

model Role {
  id            String  @id @default(uuid())
  orgId         String  @map("org_id")
  name          String
  isSystemRole  Boolean @default(false) @map("is_system_role")
  lastUpdatedBy String? @map("last_updated_by")

  organization      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lastUpdatedByUser User?            @relation("RoleLastUpdatedBy", fields: [lastUpdatedBy], references: [id], onDelete: SetNull)
  rolePermissions   RolePermission[]
  userRoles         UserRole[]

  @@unique([orgId, name])
  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId Int    @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum ScopeType {
  organization
  location
}

model UserRole {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  scopeType ScopeType @map("scope_type")
  scopeId   String    @map("scope_id")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId, scopeType, scopeId])
  @@map("user_roles")
}

// ─── Scheduling domain ───────────────────────────────────────

model Position {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  name         String
  hourlyRate   Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  isLeadership Boolean  @default(false) @map("is_leadership")

  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employeePositions EmployeePosition[]
  shifts            Shift[]
  recurrenceRules   RecurrenceRule[]

  @@index([orgId])
  @@map("positions")
}

model EmployeePosition {
  userId     String @map("user_id")
  positionId String @map("position_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([userId, positionId])
  @@map("employee_positions")
}

enum ShiftStatus {
  scheduled
  published
  completed
  cancelled
}

model Shift {
  id             String       @id @default(uuid())
  locationId     String       @map("location_id")
  positionId     String?      @map("position_id")
  assignedUserId String?      @map("assigned_user_id")
  startTime      DateTime     @map("start_time")
  endTime        DateTime     @map("end_time")
  status         ShiftStatus  @default(scheduled)
  recurrenceId   String?      @map("recurrence_id")
  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  reminderSent   Boolean      @default(false) @map("reminder_sent")
  location       Location     @relation(fields: [locationId], references: [id])
  position       Position?    @relation(fields: [positionId], references: [id])
  assignedUser   User?        @relation("AssignedShifts", fields: [assignedUserId], references: [id])
  creator        User         @relation("CreatedShifts", fields: [createdBy], references: [id])
  timeEntries    TimeEntry[]
  trades         ShiftTrade[] @relation("SourceShift")

  @@index([locationId, startTime, endTime])
  @@index([assignedUserId, startTime])
  @@map("shifts")
}

model RecurrenceRule {
  id                String    @id @default(uuid())
  locationId        String    @map("location_id")
  rrule             String
  templateStartTime String    @map("template_start_time") // stored as "HH:MM"
  templateEndTime   String    @map("template_end_time")
  positionId        String?   @map("position_id")
  activeUntil       DateTime? @map("active_until") @db.Date

  location Location  @relation(fields: [locationId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])

  @@map("recurrence_rules")
}

// ─── Swap / time-off requests ────────────────────────────────

enum SwapStatus {
  pending
  approved
  denied
  cancelled
}

enum TimeOffStatus {
  pending
  approved
  denied
}

model TimeOffRequest {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  locationId String        @map("location_id")
  startDate  DateTime      @map("start_date") @db.Date
  endDate    DateTime      @map("end_date") @db.Date
  status     TimeOffStatus @default(pending)
  reason     String?
  reviewedBy String?       @map("reviewed_by")
  createdAt  DateTime      @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@map("time_off_requests")
}

// ─── Time & attendance ───────────────────────────────────────

enum EntrySource {
  app
  manual
  import
}

// ─── Audit log ────────────────────────────────────────────────

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  orgId        String   @map("org_id")
  userId       String   @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([resourceType, resourceId])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("audit_log")
}

// ─── Shift Trade feature ────────────────────────────────────────────────
enum TradeType {
  swap
  drop
}

enum TradeStatus {
  pending_peer
  pending_manager
  approved
  rejected
  cancelled
}

model ShiftTrade {
  id              String      @id @default(uuid())
  orgId           String      @map("org_id")
  shiftId         String      @map("shift_id")
  sourceUserId    String      @map("source_user_id")
  targetUserId    String?     @map("target_user_id") // Nullable if dropping to open marketplace
  targetShiftId   String?     @map("target_shift_id") // Nullable if dropping without reciprocal swap
  type            TradeType
  status          TradeStatus @default(pending_manager)
  managerApproved Boolean?    @map("manager_approved")
  reviewedBy      String?     @map("reviewed_by")
  reviewedAt      DateTime?   @map("reviewed_at")
  reason          String?
  createdAt       DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shift        Shift        @relation("SourceShift", fields: [shiftId], references: [id], onDelete: Cascade)
  sourceUser   User         @relation("TradeSourceUser", fields: [sourceUserId], references: [id], onDelete: Cascade)
  targetUser   User?        @relation("TradeTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([shiftId])
  @@map("shift_trades")
}

enum TimeEntryStatus {
  active
  completed
  flagged
  approved
}

model TimeEntry {
  id               String          @id @default(uuid())
  orgId            String          @map("org_id")
  locationId       String          @map("location_id")
  userId           String          @map("user_id")
  shiftId          String?         @map("shift_id")
  clockIn          DateTime        @map("clock_in")
  clockOut         DateTime?       @map("clock_out")
  clockInLat       Float           @map("clock_in_lat")
  clockInLng       Float           @map("clock_in_lng")
  clockOutLat      Float?          @map("clock_out_lat")
  clockOutLng      Float?          @map("clock_out_lng")
  clockInDistance  Float           @map("clock_in_distance") // Distance in meters from location pin
  clockOutDistance Float?          @map("clock_out_distance")
  status           TimeEntryStatus @default(active)
  varianceMinutes  Int             @default(0) @map("variance_minutes") // Deviation from scheduled shift start
  notes            String?
  reviewedBy       String?         @map("reviewed_by")
  reviewedAt       DateTime?       @map("reviewed_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([locationId, clockIn])
  @@index([userId, status])
  @@map("time_entries")
}
